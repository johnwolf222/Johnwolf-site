{
  "name": "john-wolf-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run test:motion && npm run test:cases && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "predev": "node scripts/restore-approved-project-cards.mjs && node scripts/restore-brewty-media.mjs",
    "prebuild": "node scripts/restore-approved-project-cards.mjs && node scripts/restore-brewty-media.mjs",
    "test:motion": "node --test tests/spiralGalleryMotion.test.mjs tests/mobileHomepage.test.mjs",
    "test:cases": "node --test tests/caseStudies.test.mjs",
    "pretest:cases": "node scripts/restore-brewty-media.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.187.0",
    "gsap": "^3.14.2"
  },
  "devDependencies": {
    "vite": "^6.3.0"
  }
}
